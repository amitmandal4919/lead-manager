# Copy this file to backend/.env  (do NOT commit the real .env file)
#   Mac/Linux:   cp .env.example backend/.env
#   Windows:     copy .env.example backend\.env

# Port where the Express API runs
PORT=5000

# Frontend URL(s) allowed to call the API (comma separated)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# SQLite database file (relative to the backend folder). Created automatically.
DB_PATH=./data/leads.db
