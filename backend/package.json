{
  "name": "lead-manager-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Lead Manager application (Express + SQLite)",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
